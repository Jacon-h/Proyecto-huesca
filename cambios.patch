--- a/db/conf/postgresql.conf
+++ b/db/conf/postgresql.conf
@@ -1 +1,37 @@
-listen_addresses = '*'
\ No newline at end of file
+# db/conf/postgresql.conf · Configuración del gestor (ASGBD RA2)
+#
+# compose.yaml arranca PostgreSQL con  -c config_file=/etc/postgresql/postgresql.conf
+# y monta aquí este fichero (solo lectura). Lo que no aparece aquí toma su valor por defecto.
+# Cada parámetro está explicado en db/README.md.
+
+# --- Conexiones ----------------------------------------------------------------
+# Escucha en todas las interfaces DEL CONTENEDOR (red frontal, red trasera y loopback).
+# Quién puede entrar no se decide aquí, sino en pg_hba.conf.
+listen_addresses = '*'
+port = 5432
+
+# Fichero de reglas de acceso: también sale de db/conf/ (lo monta compose.yaml).
+hba_file = '/etc/postgresql/pg_hba.conf'
+
+# P5 · Límite global de conexiones del servidor. Los límites por usuario están en db/04_bifi.sh.
+max_connections = 50
+# De esas 50, 3 quedan siempre libres para el administrador (postgres), por si todo lo demás se llena.
+superuser_reserved_connections = 3
+
+# --- Autenticación -------------------------------------------------------------
+# Las contraseñas se guardan con SCRAM-SHA-256 (el valor por defecto en PostgreSQL 16; se deja escrito
+# para que case con el método scram-sha-256 de pg_hba.conf).
+password_encryption = 'scram-sha-256'
+
+# --- Registro (logs) -----------------------------------------------------------
+# Cada conexión deja en  docker logs mi-postgres  desde qué IP llega, con qué usuario y a qué base.
+# Así se ve qué IP ve el gestor desde Compose, desde el aula y desde el propio servidor.
+log_connections = on
+log_disconnections = on
+# Fecha, proceso y usuario@base delante de cada línea del registro.
+log_line_prefix = '%m [%p] %q%u@%d '
+
+# --- Hora ----------------------------------------------------------------------
+# Sin esto la imagen usa UTC y las horas del registro no cuadran con las del aula.
+log_timezone = 'Europe/Madrid'
+timezone = 'Europe/Madrid'
