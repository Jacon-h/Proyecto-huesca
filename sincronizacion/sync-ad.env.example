# /etc/huesca/sync-ad.env · Configuración de la sincronización OpenLDAP -> Active Directory.
# Se copia a /etc/huesca/sync-ad.env con permisos 600 (chmod 600). NO se sube a Git con valores reales.
# Las contraseñas no van aquí: van en ficheros aparte (chmod 600) que se indican con *_PWFILE.

# --- Origen: OpenLDAP (el contenedor publica 389 en el servidor de la sede) ---
LDAP_URI="ldap://127.0.0.1:389"
LDAP_BASE="dc=huesca,dc=empresa,dc=lan"
LDAP_BIND_DN="cn=svc-lectura,ou=servicios,dc=huesca,dc=empresa,dc=lan"
LDAP_PWFILE="/etc/huesca/ldap-lectura.pw"
# Solo lo usa cambiar-clave.sh (cambiar contraseñas en OpenLDAP):
LDAP_ADMIN_DN="cn=admin,dc=huesca,dc=empresa,dc=lan"
LDAP_ADMIN_PWFILE="/etc/huesca/ldap-admin.pw"

# --- Destino: Active Directory (LDAPS obligatorio para escribir contraseñas) ---
AD_URI="ldaps://dc1.ad.huesca.empresa.lan:636"
AD_BASE="DC=ad,DC=huesca,DC=empresa,DC=lan"
AD_UPN="ad.huesca.empresa.lan"
AD_BIND_DN="CN=svc-sync,OU=Servicios,OU=Huesca,DC=ad,DC=huesca,DC=empresa,DC=lan"
AD_PWFILE="/etc/huesca/ad-sync.pw"

# --- Salvaguarda: máximo de bajas por pasada (si hay más, no se hace ninguna) ---
MAX_BAJAS=5
