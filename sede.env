# Datos de la sede (DS4). No son secretos: van en Git.
# Es el único sitio donde aparecen. Si un fichero de configuración los necesita, se toman de aquí.
# Formato NOMBRE=valor, sin espacios alrededor del =.
SEDE=Huesca
DOMINIO=huesca.empresa.lan
INTERFAZ_AULA=enp5s0
IP_AULA=192.168.6.105/24
PUERTA_AULA=192.168.6.1
RESOLUTOR_CENTRO=192.168.6.98
RED_INTERNA=10.2.0.0/24
IP_INTERNA=10.2.0.1/24
BRIDGE_INTERNA=br-virtual
REDES_AULA="192.168.6.0/24 192.168.8.0/24 192.168.2.0/24"   # redes del aula que ven la vista "aula" del DNS
IP_DNS_SECUNDARIO=10.2.0.2

# --- Variables derivadas (NO se escriben aquí: las calcula instalar.sh dns y las usan las plantillas de dns/) ---
#   IP_INTERNA_SOLO  = IP_INTERNA sin la máscara          10.2.0.1
#   IP_AULA_SOLO     = IP_AULA sin la máscara             192.168.6.105
#   ZONA_INVERSA     = 2º y 1er octeto de RED_INTERNA, al revés   2.10.in-addr.arpa
#   PTR_SERVIDOR     = 4º y 3er octeto de IP_INTERNA, al revés    1.0
#   ACL_AULA         = REDES_AULA como lista de BIND      192.168.6.0/24; 192.168.8.0/24; ...
#   SERIAL           = número de versión de las zonas     (fecha y hora, siempre creciente)
