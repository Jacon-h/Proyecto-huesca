# .env · Secretos de la sede.
# Se crea así:  cp .env.example .env   y se rellena con  nano .env
# .env NO se sube a Git. Todos los campos son obligatorios: instalar.sh avisa si falta alguno.
# Escribe cada valor justo después del "=", sin espacios ni comentarios en la misma línea.
# El fichero se carga con "source": si una contraseña lleva $ ! # espacios o comillas, ponla entre comillas simples: CLAVE='ab$c!d'

# --- Base de datos (PostgreSQL) ---
# Nombre de la base de datos
DB_NAME=
# Usuario de LA WEB: puede leer, insertar y editar, pero NO borrar. No puede llamarse "postgres"
DB_USER=
# Contraseña de ese usuario
DB_PASSWORD=
# Contraseña del administrador "postgres" (solo para administrar la base)
POSTGRES_PASSWORD=

# --- Intranet (Apache responde 401 sin estas credenciales y 200 con ellas) ---
INTRANET_USUARIO=
INTRANET_CLAVE=

# --- OpenLDAP y LAM ---
# Administrador del directorio (cn=admin,dc=huesca,dc=empresa,dc=lan)
LDAP_ADMIN_PASSWORD=
# Administrador de la configuración de slapd
LDAP_CONFIG_PASSWORD=
# Contraseña del panel LAM
LAM_PASSWORD=

# --- Active Directory (OPCIONAL: solo para la fase "ad"; el resto de la instalación no lo necesita) ---
# Contraseña de la cuenta de servicio svc-sync que se crea en dc1 (docs/ad-windows.md)
AD_SYNC_PASSWORD=
# Contraseña inicial para los investigadores nuevos (mín. 12 caracteres, con complejidad). Si se deja
# vacía, las cuentas nacen deshabilitadas en AD hasta ejecutar: sudo cambiar-clave.sh <usuario>
AD_CLAVE_INICIAL=
