# .env · Secretos de la sede.
# Se crea así:  cp .env.example .env   y se rellena con  nano .env
# .env NO se sube a Git. Todos los campos son obligatorios: instalar.sh avisa si falta alguno.
# Escribe cada valor justo después del "=", sin espacios ni comentarios en la misma línea.

# --- Base de datos (PostgreSQL) ---
# Nombre de la base de datos
DB_NAME=
# Usuario de LA WEB: puede leer, insertar y editar, pero NO borrar. No puede llamarse "postgres"
DB_USER=
# Contraseña de ese usuario
DB_PASSWORD=
# Contraseña del administrador "postgres" (solo para administrar la base)
POSTGRES_PASSWORD=

# --- Intranet (Apache responde 401 sin estas credenciales y 200 con ellas) ---
INTRANET_USUARIO=
INTRANET_CLAVE=

# --- OpenLDAP y LAM ---
# Administrador del directorio (cn=admin,dc=huesca,dc=empresa,dc=lan)
LDAP_ADMIN_PASSWORD=
# Administrador de la configuración de slapd
LDAP_CONFIG_PASSWORD=
# Contraseña del panel LAM
LAM_PASSWORD=
